<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ElectrophoneScores" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.Electrophone.Button</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy_dark</item>
        <item name="android:navigationBarColor">@color/navy_dark</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="Widget.Electrophone.Button" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">1dp</item>
    </style>
</resources>
